# Copy to .env for local Docker Compose. Never commit actual credentials.
POSTGRES_USER=primal
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=primal_crown
DATABASE_URL=postgres://primal:replace-with-a-long-random-secret@postgres:5432/primal_crown
API_PORT=4000
INTERNAL_API_TOKEN=replace-with-a-long-random-token
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_TEST_GUILD_ID=
NEXT_PUBLIC_DISCORD_INVITE_URL=
WEB_ORIGIN=http://localhost:3000
# Game status remains "unconfigured" until verified integration is installed.
GAME_SERVER_NAME=PRIMAL CROWN | Alpha
