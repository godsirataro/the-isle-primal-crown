{
  "name": "primal-crown",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": { "node": ">=22", "npm": ">=10" },
  "scripts": {
    "dev:web": "npm run dev -w @primal-crown/web",
    "dev:api": "npm run dev -w @primal-crown/api",
    "dev:bot": "npm run dev -w @primal-crown/discord-bot",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @primal-crown/api"
  }
}
